      },
      "writtenOn": "2019-12-06T18:18:14Z",
      "side": 1,
      "message": "I might have misunderstood your comment.\nAnyway, this command is not creating a new attachment, but just updating an already available attachment.\nI modified the command to support enable/disable of attachment.\nI added the attachment-add command\nDone",
      "parentUuid": "7d202243_dbe7c7e0",
      "range": {
        "startLine": 31,
        "startChar": 13,
        "endLine": 31,
        "endChar": 31
      },
